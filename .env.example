# Smartys IPTV — Backend Secrets (kopieren nach .env, NIE committen!)

# Session-Cookie-Geheimnis (beliebiger langer Zufallswert, z.B. `openssl rand -hex 32`)
SESSION_SECRET=change-me

# Lizenz-Token-Geheimnis (32+ bytes hex, z.B. `openssl rand -hex 32`)
# WICHTIG: ohne diesen Wert sind Lizenz-Tokens (/api/v1/redeem) deaktiviert.
IPTV_LICENSE_SECRET=change-me
